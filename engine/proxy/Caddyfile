# ════════════════════ ALTERNATIVE: single-host path routing ═════
# What you originally pictured (qi.local/lottery). Left commented.
# CAVEAT: handle_path strips the prefix, so each app must be told
# its base path or its /static, /assets, redirects will 404:
#   FastAPI → uvicorn ... --root-path /lottery
#   Gradio  → demo.launch(root_path="/cypher")
# Subdomains above avoid all of this. Use this ONLY if you must
# stay on one hostname.
#
# qi.local {
# 	import site
# 	handle_path /lottery/* { reverse_proxy 127.0.0.1:8777 }
# 	handle_path /cypher/*  { reverse_proxy 127.0.0.1:7842 }
# 	handle_path /hive/*    { reverse_proxy 127.0.0.1:8600 }
# 	handle        { respond "QI Hive proxy — try /lottery or /cypher" 200 }
# }
