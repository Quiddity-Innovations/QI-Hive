# ═══════════════════════════════════════════════════════════════
# QI Hive — local reverse proxy (Caddy)
#   One clean front door for every QI app on this machine.
#   AppDirectory: C:\QIH\engine\proxy
#   Run as NSSM service: QI_Caddy
#
#   Why Caddy and not IIS: Caddy handles ASGI + websockets
#   (FastAPI, Gradio queues, Claude Voice realtime) transparently,
#   auto-issues local HTTPS, and is one readable file. IIS+ARR
#   would fight every Gradio/ML/websocket app you own.
# ═══════════════════════════════════════════════════════════════

{
	# Caddy's internal CA → trusted https://*.qi.local on this box.
	# Run `caddy trust` once to install the CA in Windows' store.
	# Delete this block if you'd rather serve plain HTTP on :80.
	local_certs
}

# ── QI Gate — the public edge (added 2026-08-05) ────────────────
# Every Cloudflare tunnel now terminates on :9040 in the imported file
# below instead of hitting app ports directly. That block is GENERATED
# from C:\QIH\engine\gate\config\gate.json — edit the JSON, then run
#   python C:\QIH\engine\gate\gen_caddyfile.py
# The *.qi.local blocks further down are LAN-only and stay unauthenticated.
import C:\QIH\engine\gate\config\Caddyfile.gate

# ---- reusable "site-grade" snippet (compression + safe headers) ----
(site) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options  nosniff
		X-Frame-Options         SAMEORIGIN
		Referrer-Policy         strict-origin-when-cross-origin
	}
}

# ════════════════════ FEATURED SITES ════════════════════════════
# The two you flagged. Root-served, compressed, hardened.
# Same blocks can sit behind their Cloudflare tunnels too.

lottery.qi.local {
	import site
	reverse_proxy 127.0.0.1:8777        # LotteryWiz (FastAPI serves UI + API)
}

cypher.qi.local {
	import site
	reverse_proxy 127.0.0.1:7842        # CypherMiner UI
}

