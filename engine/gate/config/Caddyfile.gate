:9040 {
	log {
		output file C:\QIH\engine\gate\LOGS\caddy_edge.log {
			roll_size 20mb
			roll_keep 10
		}
		format json
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# ── hive.quiddityinnovations.com  →  QI Hive Dashboard  [protected]
	#   Crown jewels: ecosystem snapshot, service control, Brain data, war room. Was fully
	#   readable by anyone before 2026-08-05.
	@h0 host hive.quiddityinnovations.com
	handle @h0 {
		handle /qi-auth/* {
			reverse_proxy 127.0.0.1:9041 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}
		handle {
			forward_auth 127.0.0.1:9041 {
				uri /qi-auth/verify
				copy_headers X-Qi-User X-Qi-Role
				header_up X-Forwarded-Proto https
			}
			reverse_proxy 127.0.0.1:8600 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}
	}

