	# ── connector.quiddityinnovations.com  →  QI Connector (remote MCP)  [open]
	#   Already enforces its own auth: bearer token for Claude Code, capability URL for
	#   claude.ai (qi_mcp_gateway.py). A cookie wall would break the MCP client, which cannot
	#   log in through a browser.
	@h18 host connector.quiddityinnovations.com
	handle @h18 {
		reverse_proxy 127.0.0.1:9030 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	# ── claudevoice.quiddityinnovations.com  →  Claude Voice (LINE webhook)  [mixed]
	#   Routes enumerated from C:\CLAUDE\Claude Voice\line_bot.py (2026-08-05): those four are
	#   all that exist. /audio/ and /media/ MUST stay public -- LINE's servers fetch media from
	#   those URLs to deliver it to users, so gating them would break voice and video replies.
	#   Both resolve with os.path.basename(), so path traversal is already blocked. Gating
	#   everything else buys per-request access logging and closes off any route added later.
	@h19 host claudevoice.quiddityinnovations.com
	handle @h19 {
		handle /qi-auth/* {
			reverse_proxy 127.0.0.1:9041 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}
		@h19_public path /line/webhook /health /audio/* /media/*
		handle @h19_public {
			reverse_proxy 127.0.0.1:8721 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}
		handle {
			forward_auth 127.0.0.1:9041 {
				uri /qi-auth/verify
				copy_headers X-Qi-User X-Qi-Role
				header_up X-Forwarded-Proto https
			}
			reverse_proxy 127.0.0.1:8721 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}
	}

