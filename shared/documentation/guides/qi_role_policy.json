{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageQiPrefixedRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::103140669477:role/qi-*"
    }
  ]
}
