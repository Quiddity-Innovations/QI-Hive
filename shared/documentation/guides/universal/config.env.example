# ============================================================
# Free Webhook-Bot Cloud Kit — configuration
#
# Copy this file to config.env and fill in your own values.
# config.env is your secrets/identity file — do NOT commit it
# to a public repo (add it to .gitignore).
#
# No shell interpolation is performed by deploy.py's parser —
# write out every value in full (don't rely on ${BOT_NAME}
# expansion). KEY=VALUE, one per line, no quotes needed.
# ============================================================

# --- AWS account ---
AWS_ACCOUNT_ID=<ACCOUNT_ID>
AWS_REGION=us-east-1

# --- Resource naming ---
# BOT_NAME is the prefix used for every AWS resource this kit
# creates. Keep it short, lowercase, hyphen-safe (e.g. "mybot").
# The other names below default to BOT_NAME-derived values in
# the example — change them if you want different names, but
# keep them consistent with each other.
BOT_NAME=mybot
QUEUE_NAME=mybot-events.fifo
LAMBDA_NAME=mybot-webhook
ROLE_NAME=mybot-webhook-role
CLI_USER_NAME=mybot-cli

# --- Secret storage ---
# SSM Parameter Store path holding the webhook platform's signing
# secret (LINE channel secret, Telegram bot token, Meta app
# secret, etc). Stored as SecureString — never in code.
SECRET_PARAM_PATH=/mybot/webhook_secret

# --- Home side (queue drainer) ---
# Local file holding the plaintext secret, read by the drainer so
# it can sign its loopback POST back to your bot server.
# Format: KEY=VALUE, one line, matching CHANNEL_SECRET_ENV_KEY.
CHANNEL_SECRET_ENV_FILE=%USERPROFILE%\secrets\mybot.env
CHANNEL_SECRET_ENV_KEY=CHANNEL_SECRET

# Your bot server's local webhook endpoint (loopback address the
# drainer forwards relayed events to).
LOCAL_WEBHOOK_URL=http://127.0.0.1:8000/webhook

# Marker header the drainer sets on its loopback POST so your
# server can tell a relayed (queued) event apart from a direct
# one, if that distinction matters to your reply logic.
RELAY_HEADER_NAME=X-Relay
RELAY_HEADER_VALUE=1

# Drainer log file (plain text, rotated at 5 MB by the script).
DRAIN_LOG_FILE=%USERPROFILE%\logs\mybot_queue_drain.log

# --- Lambda tuning (defaults are always-free-tier safe) ---
LAMBDA_RUNTIME=python3.12
LAMBDA_TIMEOUT_SECONDS=10
LAMBDA_MEMORY_MB=128
QUEUE_RETENTION_SECONDS=345600

# --- Signature verification ---
# The HTTP header your webhook source sends containing the
# request signature. Adjust lambda_function.py if your platform
# uses a different scheme entirely (see GUIDE.md GOTCHAS section
# for Telegram/Meta notes).
SIGNATURE_HEADER_NAME=X-Line-Signature

# --- Docker (optional, only used by docker-compose.yml) ---
# Public URL your bot server is reachable at, if the drainer runs
# in a container that cannot route to the host directly (see
# GUIDE.md — "container-to-host networking" gotcha). Leave blank
# to use LOCAL_WEBHOOK_URL as-is.
DOCKER_WEBHOOK_URL=
