    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-04-06T19:09:32-04:00</StartBoundary>
      <Repetition>
        <Interval>PT30M</Interval>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\1-AI\APPS\PYTHON\pythonw.exe</Command>
      <Arguments>C:\OC\tools\oc-chatgpt-keepalive.py</Arguments>
      <WorkingDirectory>C:\OC\tools</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
