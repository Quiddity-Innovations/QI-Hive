# QI Hive — gitignore
data/
logs/
LOGS/
archive/
__pycache__/

# QI Launchpad — auto-generated each launch by refresh-tunnels.py
# (static quiddityinnovations.com tunnel URLs + QR blobs; not source)
landing/tunnels.js
*.pyc
*.pyo
.venv/
node_modules/
.env
*.db
*.db-wal
*.db-shm
.claude/

# Local-only credentials store (LINE tokens, recovery codes, bot secrets)
# NEVER commit — keep entirely local
secrets/

# Auto-generated registry backups — local only
ecosystem/*.bak_*
ecosystem/*.backup-*

# Broker request queue + hive report queue — ephemeral, local only
commands/pending/
commands/completed/
commands/archive/
shared/reports/inbox/
shared/reports/archive/

# Brain vector memory + inbox — regeneratable / ephemeral, never commit
qi_memory/
**/qi_memory/
chroma/
**/chroma/
*.chroma
brain/inbox/
brain/inbox/processed/
brain/inbox/errors/

# UNIVERSAL→QIH Phase 1 migration — mirrored historical content (keep on disk, not in git)
# Allow .md design docs; ignore only binary/ephemeral subtrees
shared/documentation/session_summaries/
shared/documentation/*.docx
shared/documentation/*.py
shared/documentation/*.txt
shared/training/
shared/sessions_universal/
.claude_universal/

# Env / secret files — match ANY *.env, not just literal ".env"
# (e.g. config/warroom_telegram.env carries a live Telegram bot token).
# Keep committable example templates.
*.env
!*.env.example

# Editor / script backups — never commit
*.bak
*.bak-*
*.bak_*

# Scratch + local archive dirs — root-level only, local & regeneratable
# (anchored so nested dirs like docs/_archive/ stay tracked)
/temp/
/_archive/

# Tooling binaries — keep on disk, never commit to source control
# (caddy.exe ~51MB, nssm.exe, rcedit.exe, per-product *_NSSM.exe copies).
# See engine/bin/README.md for what they are and where to get them.
engine/bin/*.exe
# ...except the sanctioned, already-tracked standardized NSSM binary.
!engine/bin/nssm.exe
